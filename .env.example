# ==============================================================================
# Docker Compose 必填变量 (required by docker-compose.yml)
# 在本目录创建 .env 文件（已被 .gitignore 忽略）并填入你自己的强密码。
# Create a .env file in this directory (git-ignored) and set your own strong passwords.
# 未设置时 docker-compose 会直接报错退出，避免误用弱默认密码。
# 注意：密码中若含 @ : / 等字符，URL 形式需要做百分号编码。
# ==============================================================================
# PostgreSQL 密码：同时用于 postgres 服务与后端的 SQL_DSN
# POSTGRES_PASSWORD=replace-with-a-strong-password
# Redis 密码：同时用于 redis 服务与后端的 REDIS_CONN_STRING
# REDIS_PASSWORD=replace-with-a-strong-password

# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=heqiuyu-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥（必填，长度 >= 32 个字符）
# 用于签名会话 Cookie；旧占位值 random_string 会在启动时被拒绝。
# 生成方式：openssl rand -base64 48
# 修改该值会使所有已登录会话立即失效（需要重新登录）。
# Session secret (required, >= 32 characters).
# Signs session cookies; the old placeholder value random_string is rejected at startup.
# Generate with: openssl rand -base64 48
# Changing it invalidates all existing sessions.
# SESSION_SECRET=<openssl rand -base64 48>

# 加密密钥（必填，长度 >= 32 个字符，且不得与 SESSION_SECRET 相同）
# 用于派生 HMAC 密钥（后续也用于派生加密密钥）。
# 丢失或修改该值会改变全部派生密钥：签名校验失败、已有密文无法解密。
# 请与数据库分开备份：数据库备份无法恢复该密钥。
# Crypto secret (required, >= 32 characters, must NOT be the same value as SESSION_SECRET).
# Derives HMAC keys (and, going forward, encryption keys).
# Losing or changing it changes every derived key: signatures stop verifying and
# data encrypted with it can no longer be decrypted.
# Back it up separately from the database - a database backup cannot restore it.
# CRYPTO_SECRET=<openssl rand -base64 48>

# 安全相关配置 / Security
# 会话 Cookie 是否仅通过 HTTPS 传输（默认 false）
# 使用 HTTPS（反向代理/CDN/云上）时请设为 true，避免 Cookie 明文传输。
# 生产环境保持 false 会在启动时输出警告。
# COOKIE_SECURE=false
# 跨域来源白名单（逗号分隔）
# 设置后仅放行列出的来源，并仅对这些来源开启跨域凭证（Cookie）。
# 未设置时允许所有来源，但不允许携带凭证。
# CORS_ALLOW_ORIGINS=https://admin.example.com,https://app.example.com
# 可信反向代理 CIDR 列表（逗号分隔）
# 未设置或为空时只信任 socket 对端地址，因此忽略 X-Forwarded-For / X-Real-IP，
# 客户端 IP 会退化为代理地址（影响限流与令牌 IP 白名单）。
# 部署在反向代理/CDN 之后时请填入真实代理网段。
# 注意：* 表示信任所有代理，可被用于伪造客户端 IP，切勿在生产使用。
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
# 渠道 base_url 严格校验（默认 false）
# 设为 true 时按 SSRF 策略校验渠道 base_url，自建/内网 IP 上游会被拒绝。
# CHANNEL_BASE_URL_STRICT=false

# 信任额度旁路 / Trust quota bypass
# 是否启用信任额度旁路（默认 false）
# false：每个请求都先预扣估算费用（推荐，可避免并发超额消费）。
# true：余额高于阈值的账户跳过预扣费，短时间突发可能造成超额消费。
# TRUST_QUOTA_ENABLED=false
# 预扣费旁路阈值（仅在 TRUST_QUOTA_ENABLED=true 时生效）
# TRUST_QUOTA=0

# 登录失败锁定（按账号）/ Login failure lockout (account-scoped)
# 同一账号连续登录失败达到该次数后锁定，默认 10 次，锁定时长默认 900 秒。
# 计数按账号而非客户端 IP，独立于来源 IP，无法通过伪造 X-Forwarded-For 绕过。
# Consecutive failed logins per account before lockout: default 10 attempts / 900 seconds.
# Counting is account-scoped (independent of client IP), so spoofing X-Forwarded-For cannot bypass it.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_LIMIT_DURATION=900
# 登录失败锁定总开关（默认 true）
# LOGIN_RATE_LIMIT_ENABLE=true

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
